#!/usr/bin/env bash
#SBATCH --account=general
#SBATCH --job-name=progprompt_qwen35_9b
#SBATCH --partition=batch
#SBATCH --time=20:00:00
#SBATCH --signal=B:TERM@300
#SBATCH --output=/home-mscluster/%u/slurm-logs/progprompt_qwen35_9b/%j.out
#SBATCH --error=/home-mscluster/%u/slurm-logs/progprompt_qwen35_9b/%j.err
# adaptpolicies: self-submit
#
# ProgPrompt temperature x reasoning sweep for Qwen3.5-9B Q4_K_M: one Slurm job
# per dataset, six conditions per job, one attempt per task, plan budget
# 8192 tokens with a 600 s request timeout (local baseline: 4096 tokens, 300 s).
# Submit from the login node with bash (not sbatch); this checks node availability
# and submits one job per dataset (all five by default):
#   bash src/slurm-scripts/progprompt_qwen35_9b.sh [DATASET ...]
# Inside each job, helper-scripts/sweep.sh does the work.
# No CPU, memory, GPU or exclusive directives: nodes are allocated whole.
# The 5.6 GB model fits a batch node's 12 GB RTX 3060 and a bigbatch RTX 3090,
# so both partitions are used; batch first, leaving bigbatch for the 27B model.
# Results: ~/outputs/experiments/$SWEEP_CAMPAIGN/<dataset>/<run>.
set -euo pipefail
export SWEEP_MODEL_TAG=qwen35-9b
export SWEEP_MODEL_ID=qwen/qwen3.5-9b
export SWEEP_PLAN_TOKENS=8192   # config/dev-<tag>-<temp>-m8192-<reasoning>.yaml
# Open-ended goals get a larger budget (configs set a 1200 s timeout for m16384).
export SWEEP_PLAN_TOKENS_BY_DATASET="test_unseen_ambiguous_goals=16384"
export SWEEP_GGUF="/datasets/$(id -un)/lmstudio/models/lmstudio-community/Qwen3.5-9B-GGUF/Qwen3.5-9B-Q4_K_M.gguf"
export SWEEP_CAMPAIGN="${SWEEP_CAMPAIGN:-cluster_qwen35_9b_002}"
export SWEEP_PARTITIONS="batch bigbatch"
export SWEEP_TIME=20:00:00
# Known-faulty nodes, skipped at submission. mscluster76: GPU not found by
# nvidia-smi (2026-11-11), so LM Studio fell back to the CPU.
export SWEEP_EXCLUDE_NODES=mscluster76
PROJECT_ROOT="${PROJECT_ROOT:-$HOME/AdaptPolicies}"

if [[ -z ${SLURM_JOB_ID:-} ]]; then
  exec bash "$PROJECT_ROOT/helper-scripts/submit_sweep.sh" "$(realpath -- "$0")" "$@"
fi
exec bash "$PROJECT_ROOT/helper-scripts/sweep.sh" "$@"
